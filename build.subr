#!/usr/bin/env bash
#
# Shell script for building Phoenix-RTOS firmware
#
# Common functions
#
# Copyright 2018, 2019, 2024 Phoenix Systems
# Author: Kaja Swat, Aleksander Kaminski, Pawel Pisarczyk
#

# b_install(src ..., dstdir)
b_install() {
	local filelist=("${@:1:$#-1}")
	local dstdir="${@: -1}"

	local absdir="${PREFIX_FS}/root/$dstdir"

	mkdir -p "$absdir"

	for file in "${filelist[@]}"; do
		if ! [ -f "$file" ]; then
			echo -e "\033[0;31mFile $file does not exist \033[0m"
			exit 1
		fi

		echo -e "\033[0;35mInstalling $(basename "$file") into $dstdir \033[0m"
		install -m 755 "$file" "$absdir"
	done
}

b_log() {
	echo -e "\033[1;33m--- $1 ---\033[0m"
}

b_die() {
	echo -e "\033[1;31mFAILED: $1\033[0m"
	exit 1
}

# b_make_test(dir ...) - build and install unit tests of the given repositories
#
# Which tests take part is decided by the makefiles (DEFAULT_TEST_COMPONENTS) -
# a repository without any is a no-op.
b_make_test() {
	local dir
	for dir in "$@"; do
		make -C "$dir" test-install
	done
}

# b_make_test_run(dir ...) - build, install and run unit tests of the given
# repositories
#
# Only possible where the build host is the target; cross-built tests are
# installed into the rootfs and run on the device instead. Every repository is
# run even if an earlier one failed - a report stopping at the first broken suite
# is of little use in CI - and the failure is propagated afterwards.
b_make_test_run() {
	local dir rc=0

	for dir in "$@"; do
		make -C "$dir" test-run || rc=$?
		# ... but a run interrupted from the keyboard should stop right there
		# rather than start the next repository
		[ "$rc" -eq 130 ] && break
	done
	return $rc
}

export -f b_log b_install b_die b_make_test b_make_test_run
